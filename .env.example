# Anthropic API 키 (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-여기에-키-입력

# 사용할 Claude 모델 (기본값)
ANTHROPIC_MODEL=claude-sonnet-4-6

# 공공데이터포털 나라장터 입찰공고 인증키 (Phase 1부터 필요)
# https://www.data.go.kr/data/15129394/openapi.do 에서 활용신청 후 발급
DATA_GO_KR_SERVICE_KEY=여기에-인증키-입력

# (선택) 호출 신뢰성 설정 — 미설정 시 아래 기본값 사용
# Anthropic 재시도 횟수 / 요청 타임아웃(초)
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_TIMEOUT=60
# 나라장터(requests) 재시도 횟수 (429/5xx 대상)
DATA_GO_KR_MAX_RETRIES=3

# (선택) 영업부 포털 공유 서버(serve_portal.py)의 CSRF 토큰.
# 미설정 시 기본값 사용. 바꾸면 portal/script.js의 PORTAL_TOKEN도 같은 값으로 맞출 것.
PORTAL_TOKEN=portal-sales-2026
